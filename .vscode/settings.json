{
  "json.schemas": [
    {
      "fileMatch": ["**/devcontainer-template.json"],
      "url": "./.vscode/schemas/devcontainer-template.schema.json"
    }
  ],
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/release.yaml"
  ],
  "workbench.editor.customLabels.patterns": {
    "**/src/**/.devcontainer/**": "${filename}(${dirname(2)})",
    "**/src/**": "${filename}(${dirname})"
  }
}
