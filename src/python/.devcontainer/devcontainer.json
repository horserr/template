{
  "name": "dev-Python",

  "image": "ghcr.io/horserr/base:latest",

  "runArgs": [
    // note: cannot use host network for wslc
    // use this domain for windows host: host.docker.internal
    // "--network=host"
    "--gpus",
    "all"
  ],

  "containerEnv": {
    "GITHUB_USERNAME": "horserr",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GITHUB_ACCESS_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "http.useLocalProxyConfiguration": false
      },
      "extensions": [
        "FanaticPythoner.better-todo-tree",
        "ms-python.python",
        "charliermarsh.ruff",
        "the0807.uv-toolkit",
        "fill-labs.dependi",
        "meta.pyrefly"
      ]
    }
  },

  "onCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && curl -fsSL https://pixi.sh/install.sh | bash",

  "postCreateCommand": "chezmoi init --source=~/.config/.dotfiles --apply $GITHUB_USERNAME"
}
