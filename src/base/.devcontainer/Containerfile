# Base image
FROM ghcr.io/horserr/base:latest

# Bake the dev container lifecycle scripts into the image so they are always
# available at a fixed path, independently of the (volume-backed) workspace.
#
# Why: devcontainer.json sets
#   "workspaceMount": "source=dev-base,target=/home/vscode/workspace,type=volume"
# so ${containerWorkspaceFolder} (/home/vscode/workspace) is a named volume that
# does NOT contain the local .devcontainer folder. Referencing the scripts from
# the workspace therefore fails with exit code 127 ("not found").

COPY .devcontainer/scripts/onCreate.sh .devcontainer/scripts/postCreate.sh /usr/local/share/devcontainer/

RUN chmod +x \
  /usr/local/share/devcontainer/onCreate.sh \
  /usr/local/share/devcontainer/postCreate.sh
